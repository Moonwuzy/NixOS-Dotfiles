{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "cyan"
    },
    "key": {
      "width": 18
    }
  },

  "modules": [
    "title",
    "separator",

    "os",
    "host",
    "kernel",
    "uptime",

    {
      "type": "packages",
      "key": "Nix",
      "format": "{nix-system} system / {nix-user} user"
    },
    {
      "type": "packages",
      "key": "Flatpak",
      "format": "{flatpak-system} system / {flatpak-user} user"
    },
    {
      "type": "packages",
      "key": "AppImage",
      "format": "{appimage}"
    },

    "break",

    "wm",
    "theme",
    "icons",
    "font",
    "cursor",

    "break",

    "terminal",
    "terminalfont",
    "shell",

    "break",

    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",

    {
      "type": "command",
      "key": "Lifetime",
      "text": "awk 'BEGIN { printf \"%.2f days\", (systime() - 1791240449) / 86400 }'"
    },

    "break",
    "colors"
  ]
}
