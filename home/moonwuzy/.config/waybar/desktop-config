{
    "layer": "bottom",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 3,

    "modules-left": [
        "custom/brand",
        "sway/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "custom/gpu",
        "network",
        "custom/help",
        "tray",
        "pulseaudio",
        "battery",
        "backlight",
        "custom/power"
    ],

    "custom/brand": {
        "format": "   私はBLが大好きです"  ,
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "format-icons": {
            "default": " ",
            "focused": "*",
            "urgent": "!"
        }
    },

    "clock": {
        "format": " {:%I:%M %p %A, %b %d} ",
        "interval": 1
    },
    
"cpu": {
    "format": "󰻠 {usage}%",
    "interval": 1,
    "tooltip": true
},

"memory": {
    "format": "󰍛 {percentage}%",
    "interval": 1,
    "tooltip": true
},

"custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "format": "󰢮 {}%",
    "interval": 2,
    "tooltip": "NVIDIA GPU utilization",
    "return-type": "text"
},    
    "custom/help": {
        "format": " 󰋖 ",
        "on-click": "/home/moonwuzy/.config/wofi/help.sh"
    },

    "pulseaudio": {
        "max-volume": 100,
        "format": " 󰕾 {volume}% ",
        "format-muted": " 󰖁 muted ",
        "on-click": "pavucontrol",
        "scroll-step": 2
    },

    "battery": {
        "format": "{icon} {capacity}% ",
        "format-charging": "󰂄 {capacity}% ",
        "format-icons": [
            "󰂃",
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂀",
            "󰁹"
        ]
    },

    "backlight": {
        "format": "󰃠 ",
        "on-click": "brightnessctl set 5%+",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "custom/power": {
        "format": "  ",
        "on-click": "/run/current-system/sw/bin/wlogout"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 6,
        "show-passive-items": true
        }
}
